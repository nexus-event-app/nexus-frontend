# URL base de la API. Déjala vacía para usar '/api' (proxy de Vite en desarrollo, nginx en Docker).
VITE_API_URL=

# URL pública del sitio (canonical, Open Graph, JSON-LD). Se fija en tiempo de build.
VITE_SITE_URL=http://localhost:5173

# Datos legales del titular (aviso legal y política de privacidad, obligatorios por la LSSI y el RGPD).
# Rellénalos solo en el servidor al publicar: no los subas al repositorio.
VITE_LEGAL_OWNER_NAME=
VITE_LEGAL_OWNER_ID=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
# Proveedor de alojamiento (encargado del tratamiento), p. ej. "Hetzner Online GmbH (Alemania)"
VITE_LEGAL_HOSTING_PROVIDER=
