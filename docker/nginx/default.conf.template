# Plantilla procesada por el entrypoint de nginx (envsubst). Solo se sustituye ${BACKEND_URL}.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location ^~ /uploads/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location = /sitemap.xml {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location = /robots.txt {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass ${BACKEND_URL};
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~* \.(?:png|jpg|jpeg|webp|svg|ico|webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
